<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outer Shadow: 0px 4px 24px rgba(0,0,0,0.18) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2E000000" />
            <corners android:radius="60dp" />
        </shape>
    </item>

    <!-- Glass Tint: rgba(255,255,255,0.06) -->
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#0FFFFFFF" />
            <corners android:radius="58dp" />
        </shape>
    </item>

    <!-- Inner Highlight Border: rgba(255,255,255,0.45) -->
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="#73FFFFFF" />
            <corners android:radius="58dp" />
        </shape>
    </item>

</layer-list>