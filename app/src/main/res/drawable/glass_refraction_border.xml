<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outer Shadow -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2E000000" />
            <corners android:radius="60dp" />
        </shape>
    </item>

    <!-- Rainbow Refraction Border (light bending effect) -->
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="3dp"
                android:color="#FFFFFF" />
            <corners android:radius="57dp" />
        </shape>
    </item>

    <!-- Inner Glass Tint -->
    <item
        android:bottom="5dp"
        android:left="5dp"
        android:right="5dp"
        android:top="5dp">
        <shape android:shape="rectangle">
            <solid android:color="#0FFFFFFF" />
            <corners android:radius="55dp" />
        </shape>
    </item>

</layer-list>