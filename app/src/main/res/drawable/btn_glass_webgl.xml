<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outer Glow/Shadow (like -shadow-color: rgba(255,255,255,0.45)) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#73FFFFFF" /> <!-- 45% white -->
            <corners android:radius="60dp" />
        </shape>
    </item>

    <!-- Glass Tint Layer (like -tint-opacity: 0.06) -->
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#0FFFFFFF" /> <!-- 6% white -->
            <corners android:radius="58dp" />
        </shape>
    </item>

    <!-- Highlight Border -->
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="#73FFFFFF" /> <!-- 45% white -->
            <corners android:radius="58dp" />
        </shape>
    </item>

</layer-list>