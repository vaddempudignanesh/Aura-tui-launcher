<?xml version="1.0" encoding="utf-8"?>
<!--
    Glass panel with simulated edge refraction/bending, like iOS 17 frosted glass.
    Technique: stack multiple shapes to fake a light-catching bevel:
      1. Outer highlight ring  - bright diagonal gradient stroke (light hitting the curved edge)
      2. Inner shadow ring     - dark stroke just inside, faking light bending away from the edge
      3. Base tint fill        - the actual frosted glass tint
      4. Top inner glow        - soft white gradient overlay concentrated at the top edge,
                                 mimicking specular refraction highlight
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1. Outer highlight ring: diagonal light-to-dark gradient stroke -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="60dp" />
            <solid android:color="#00000000" />
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#80FFFFFF"
                android:centerColor="#20FFFFFF"
                android:endColor="#05FFFFFF" />
        </shape>
    </item>



    <!-- 2. Inner shadow ring, inset 1dp: simulates refraction bending light inward -->
    <item
        android:top="1dp"
        android:left="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="59dp" />
            <solid android:color="#00000000" />
            <stroke
                android:width="2dp"
                android:color="#26000000" />
        </shape>
    </item>

    <!-- 3. Base frosted tint fill, inset 2dp so the rings above remain visible -->
    <item
        android:top="2dp"
        android:left="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="58dp" />
            <solid android:color="#1AFFFFFF" />
        </shape>
    </item>

    <!-- 4. Top specular glow: bright soft gradient near the top edge only,
            faking curved-glass light bending, fading out by mid-height -->
    <item
        android:top="2dp"
        android:left="2dp"
        android:right="2dp"
        android:bottom="2dp"
        android:gravity="top">
        <shape
            android:shape="rectangle"
            android:top="0dp">
            <corners
                android:topLeftRadius="58dp"
                android:topRightRadius="58dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
            <size android:height="40dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#40FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>

</layer-list>