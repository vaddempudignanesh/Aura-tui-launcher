<?xml version="1.0" encoding="utf-8"?>
<!--
    Matches the pasted CSS reference:
    border-radius: 60px
    background-color: rgba(255,255,255,0.06)  -> -tint-color / -tint-opacity
    border: 1px solid rgba(255,255,255,0.35)-ish -> -accent tint on edge
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="60dp" />
            <solid android:color="#1AFFFFFF" /> <!-- ~10% white tint -->
            <stroke
                android:width="1dp"
                android:color="#40FFFFFF" /> <!-- soft glass edge highlight -->
        </shape>
    </item>
</layer-list>