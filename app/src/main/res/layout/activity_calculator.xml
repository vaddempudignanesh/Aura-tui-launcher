<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/calc_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:padding="16dp">

    <!-- BLUR TARGET - make it match parent and behind glass -->
    <View
        android:id="@+id/blur_target"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent" />

    <!-- GLASS PANEL - full width, wrap content height -->
    <RelativeLayout
        android:id="@+id/glass_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:background="@drawable/bg_glass_panel"
        android:padding="20dp"
        android:elevation="24dp">

        <!-- Back Button -->
        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_back"
            android:background="#33FFFFFF"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"
            android:padding="8dp"
            android:tint="#FFFFFF" />

        <!-- Display -->
        <TextView
            android:id="@+id/calc_display"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_below="@id/btn_back"
            android:layout_marginTop="4dp"
            android:background="#0DFFFFFF"
            android:gravity="end|center_vertical"
            android:padding="16dp"
            android:text="0"
            android:textSize="40sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:ellipsize="none"
            android:marqueeRepeatLimit="marquee_forever"/>

        <!-- Grid Layout for Buttons -->
        <GridLayout
            android:id="@+id/calc_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/calc_display"
            android:layout_marginTop="16dp"
            android:columnCount="4"
            android:rowCount="5">

            <!-- Row 1 -->
            <Button android:id="@+id/btn_clear" style="@style/CalcButtonOp" android:text="C"/>
            <Button android:id="@+id/btn_backspace" style="@style/CalcButtonOp" android:text="⌫"/>
            <Button android:id="@+id/btn_divide" style="@style/CalcButtonOp" android:text="÷"/>
            <Button android:id="@+id/btn_multiply" style="@style/CalcButtonOp" android:text="×"/>

            <!-- Row 2 -->
            <Button android:id="@+id/btn_7" style="@style/CalcButton" android:text="7"/>
            <Button android:id="@+id/btn_8" style="@style/CalcButton" android:text="8"/>
            <Button android:id="@+id/btn_9" style="@style/CalcButton" android:text="9"/>
            <Button android:id="@+id/btn_minus" style="@style/CalcButtonOp" android:text="-"/>

            <!-- Row 3 -->
            <Button android:id="@+id/btn_4" style="@style/CalcButton" android:text="4"/>
            <Button android:id="@+id/btn_5" style="@style/CalcButton" android:text="5"/>
            <Button android:id="@+id/btn_6" style="@style/CalcButton" android:text="6"/>
            <Button android:id="@+id/btn_plus" style="@style/CalcButtonOp" android:text="+"/>

            <!-- Row 4 -->
            <Button android:id="@+id/btn_1" style="@style/CalcButton" android:text="1"/>
            <Button android:id="@+id/btn_2" style="@style/CalcButton" android:text="2"/>
            <Button android:id="@+id/btn_3" style="@style/CalcButton" android:text="3"/>
            <Button android:id="@+id/btn_equals" style="@style/CalcButtonEquals" android:text="="/>

            <!-- Row 5 -->
            <Button android:id="@+id/btn_0" style="@style/CalcButton" android:text="0" android:layout_columnSpan="2"/>
            <Button android:id="@+id/btn_decimal" style="@style/CalcButton" android:text="."/>
            <Button android:id="@+id/btn_history" style="@style/CalcButtonOp" android:text="📜"/>

        </GridLayout>
    </RelativeLayout>
</RelativeLayout>