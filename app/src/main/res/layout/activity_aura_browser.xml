<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FF000000">

    <!-- ═══════════════════════════════════════════════════════
         TOP BAR — address bar + GO only (no 3-dot menu anymore)
         ═══════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/aura_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:paddingVertical="4dp"
        android:background="#FF0A0A0A"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/aura_et_url"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="#FF111111"
            android:hint="search or url"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#FF33FF33"
            android:textColorHint="#FF1A7A1A"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:selectAllOnFocus="true" />

        <Button
            android:id="@+id/aura_btn_go"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="48dp"
            android:layout_height="38dp"
            android:text="GO"
            android:textColor="#FF33FF33"
            android:textSize="12sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- Thin progress bar -->
    <ProgressBar
        android:id="@+id/aura_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:max="100"
        android:progressTint="#FF33FF33"
        android:visibility="gone" />

    <!-- ═══════════════════════════════════════════════════════
         WebView container — we add/remove WebViews here dynamically
         ═══════════════════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/aura_web_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FF000000" />

    <!-- ═══════════════════════════════════════════════════════
         FOOTER — skinny icons, no text labels
         Back | Forward | Tabs[count] | Incognito | Downloads
         ═══════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/aura_footer_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="2dp"
        android:paddingHorizontal="2dp"
        android:background="#FF0A0A0A"
        android:gravity="center_vertical"
        android:weightSum="5">

        <ImageButton
            android:id="@+id/aura_btn_back"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_previous"
            android:contentDescription="Back"
            android:scaleType="centerInside"
            android:padding="4dp"
            app:tint="#FF33FF33" />

        <ImageButton
            android:id="@+id/aura_btn_forward"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_next"
            android:contentDescription="Forward"
            android:scaleType="centerInside"
            android:padding="4dp"
            app:tint="#FF33FF33" />

        <!-- Tabs button: icon + count badge overlaid -->
        <FrameLayout
            android:id="@+id/aura_btn_tabs_container"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@android:drawable/ic_menu_sort_by_size"
                android:scaleType="centerInside"
                android:padding="4dp"
                android:contentDescription="Tabs"
                app:tint="#FF33FF33" />

            <TextView
                android:id="@+id/aura_tab_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="1dp"
                android:layout_marginEnd="2dp"
                android:background="#FF33FF33"
                android:paddingHorizontal="4dp"
                android:paddingVertical="0dp"
                android:text="1"
                android:textColor="#FF000000"
                android:textSize="9sp"
                android:textStyle="bold" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/aura_btn_incognito"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_view"
            android:contentDescription="New incognito tab"
            android:scaleType="centerInside"
            android:padding="4dp"
            app:tint="#FF33FF33" />

        <ImageButton
            android:id="@+id/aura_btn_downloads"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/stat_sys_download"
            android:contentDescription="Downloads"
            android:scaleType="centerInside"
            android:padding="4dp"
            app:tint="#FF33FF33" />
    </LinearLayout>

</LinearLayout>