<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:clickable="true"
    android:focusable="true">

    <!-- ===== TOP NAVIGATION BAR ===== -->
    <RelativeLayout
        android:id="@+id/topNavBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FF000000"
        android:elevation="12dp"
        android:visibility="visible">

        <ImageButton
            android:id="@+id/btnBackGallery"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_back"
            android:background="#00000000"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:layout_marginStart="8dp"
            app:tint="#FFFFFF" />

        <TextView
            android:id="@+id/titleGallery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Gallery"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- ===== SELECTION TOP BAR ===== -->
    <RelativeLayout
        android:id="@+id/selectionTopBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FF000000"
        android:visibility="gone"
        android:elevation="12dp">

        <ImageButton
            android:id="@+id/btnCloseSelection"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_close"
            android:background="#00000000"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:layout_marginStart="8dp"
            app:tint="#FFFFFF" />

        <TextView
            android:id="@+id/selectionCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="0 selected"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- ===== EMPTY STATE ===== -->
    <RelativeLayout
        android:id="@+id/emptyStateContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/topNavBar"
        android:layout_above="@+id/bottomBar"
        android:visibility="gone"
        android:gravity="center">

        <TextView
            android:id="@+id/emptyStateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="No media found"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />
    </RelativeLayout>

    <!-- ===== GALLERY GRID ===== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/galleryRecycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/topNavBar"
        android:layout_above="@+id/bottomBar"
        android:padding="4dp"
        android:clipToPadding="false" />

    <!-- ===== ALBUM GRID ===== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/albumRecycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/topNavBar"
        android:layout_above="@+id/bottomBar"
        android:visibility="gone"
        android:padding="8dp" />
    <!-- ===== BOTTOM BAR (HOME) ===== -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FF000000"
        android:elevation="16dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/btnHome"
            style="@style/BottomBarButton"
            android:layout_marginEnd="6dp"
            android:text="🏠 Home" />

        <TextView
            android:id="@+id/btnAlbums"
            style="@style/BottomBarButton"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:text="📁 Albums" />

        <TextView
            android:id="@+id/btnSort"
            style="@style/BottomBarButton"
            android:layout_marginStart="6dp"
            android:text="🔽 Sort" />

    </LinearLayout>
    <!-- ===== SELECTION BOTTOM BAR ===== -->
    <LinearLayout
        android:id="@+id/selectionBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FF000000"
        android:elevation="16dp"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnBinSelected"
            style="@style/BottomBarButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🗑️ Bin"
            android:textColor="#FF4444"
            android:textSize="14sp" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#33FFFFFF" />

        <TextView
            android:id="@+id/btnShareSelected"
            style="@style/BottomBarButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="📤 Share"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#33FFFFFF" />

        <TextView
            android:id="@+id/btnInfoSelected"
            style="@style/BottomBarButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="ℹ️ Info"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#33FFFFFF" />

        <TextView
            android:id="@+id/btnFavoriteSelected"
            style="@style/BottomBarButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⭐ Favorite"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- ===== BIN BOTTOM BAR ===== -->
    <LinearLayout
        android:id="@+id/binBottomBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FF000000"
        android:elevation="16dp"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnRestore"
            style="@style/BottomBarButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="↩️ Restore"
            android:textColor="#4CAF50"
            android:textSize="14sp" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#33FFFFFF" />

        <TextView
            android:id="@+id/btnDeletePermanent"
            style="@style/BottomBarButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🗑️ Delete"
            android:textColor="#FF4444"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- ===== SORT OPTIONS ===== -->
    <LinearLayout
        android:id="@+id/sortOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/bottomBar"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="#FF000000"
        android:padding="8dp"
        android:elevation="12dp">

        <TextView
            android:id="@+id/sortImages"
            style="@style/SortOptionButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="🖼️ Images"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:padding="8dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33FFFFFF" />

        <TextView
            android:id="@+id/sortVideos"
            style="@style/SortOptionButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="🎬 Videos"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:padding="8dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33FFFFFF" />

        <TextView
            android:id="@+id/sortFavorites"
            style="@style/SortOptionButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="⭐ Favorites"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:padding="8dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33FFFFFF" />

        <TextView
            android:id="@+id/sortBin"
            style="@style/SortOptionButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="🗑️ Bin"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:padding="8dp" />
    </LinearLayout>

    <!-- ===== VIDEO PLAYER OVERLAY ===== -->
    <RelativeLayout
        android:id="@+id/videoPlayerContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#CC000000"
        android:clickable="true"
        android:focusable="true"
        android:fitsSystemWindows="false">

        <VideoView
            android:id="@+id/videoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true" />

        <LinearLayout
            android:id="@+id/videoCenterControls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="#00000000"
            android:padding="24dp"
            android:elevation="24dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btnSkipBackward"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_skip_back"
                android:background="#00000000"
                app:tint="#FFFFFF"
                android:scaleType="centerInside" />

            <ImageButton
                android:id="@+id/btnCenterPlayPause"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@android:drawable/ic_media_play"
                android:background="#00000000"
                app:tint="#FFFFFF"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:scaleType="centerInside" />

            <ImageButton
                android:id="@+id/btnSkipForward"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_skip_forward"
                android:background="#00000000"
                app:tint="#FFFFFF"
                android:scaleType="centerInside" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/videoBottomControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="12dp"
            android:background="#FF000000"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btnFavorite"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:src="@drawable/ic_star_empty"
                android:background="#00000000"
                app:tint="#FFD700"
                android:scaleType="centerInside" />

            <ImageButton
                android:id="@+id/btnDelete"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:src="@drawable/ic_delete"
                android:background="#00000000"
                app:tint="#FF4444"
                android:scaleType="centerInside" />

            <ImageButton
                android:id="@+id/btnPlayPause"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.5"
                android:src="@android:drawable/ic_media_play"
                android:background="#00000000"
                app:tint="#FFFFFF"
                android:scaleType="centerInside" />

            <ImageButton
                android:id="@+id/btnRotate"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:src="@drawable/ic_rotate"
                android:background="#00000000"
                app:tint="#FFFFFF"
                android:scaleType="centerInside" />

            <ImageButton
                android:id="@+id/btnInfo"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:src="@drawable/ic_info"
                android:background="#FF000000"
                app:tint="#FFFFFF"
                android:scaleType="centerInside" />

            <ImageButton
                android:id="@+id/btnCloseVideo"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:src="@drawable/ic_close"
                android:background="#00000000"
                app:tint="#FFFFFF"
                android:scaleType="centerInside" />
        </LinearLayout>

        <TextView
            android:id="@+id/videoTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/videoBottomControls"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="8dp"
            android:text="00:00 / 00:00"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:visibility="gone" />
    </RelativeLayout>

</RelativeLayout>