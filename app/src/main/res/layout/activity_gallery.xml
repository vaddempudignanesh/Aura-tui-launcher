<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:clickable="true"
    android:focusable="true">

    <ProgressBar
        android:id="@+id/loadingSpinner"
        style="?android:attr/progressBarStyle"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_centerInParent="true"
        android:indeterminate="true"
        android:visibility="gone"
        android:elevation="1000dp" />
    <RelativeLayout

        android:id="@+id/topNavBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FF000000"
        android:elevation="12dp">

        <ImageButton
            android:id="@+id/btnBackGallery"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_back"
            android:background="#00000000"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:layout_marginStart="8dp"
            app:tint="#FFFFFF" />

        <TextView
            android:id="@+id/titleGallery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Gallery"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- ===== SELECTION TOP BAR ===== -->
    <RelativeLayout
        android:id="@+id/selectionTopBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FF000000"
        android:visibility="gone"
        android:elevation="12dp">

        <ImageButton
            android:id="@+id/btnCloseSelection"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_close"
            android:background="#00000000"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:layout_marginStart="8dp"
            app:tint="#FFFFFF" />

        <TextView
            android:id="@+id/selectionCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="0 selected"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- ===== EMPTY STATE ===== -->
    <RelativeLayout
        android:id="@+id/emptyStateContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/topNavBar"
        android:layout_above="@+id/bottomBar"
        android:visibility="gone"
        android:gravity="center">

        <TextView
            android:id="@+id/emptyStateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="No media found"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />
    </RelativeLayout>

    <!-- ===== GALLERY GRID ===== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/galleryRecycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/topNavBar"
        android:layout_above="@+id/bottomBar"
        android:padding="4dp"
        android:clipToPadding="false" />

    <!-- ===== ALBUM GRID ===== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/albumRecycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/topNavBar"
        android:layout_above="@+id/bottomBar"
        android:visibility="gone"
        android:padding="8dp"
        android:background="#FF000000" />
    <!-- ===== FULLSCREEN OVERLAY ===== -->
    <RelativeLayout
        android:id="@+id/fullscreenOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:visibility="gone"
        android:elevation="100dp"
        android:clickable="true"
        android:focusable="true">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/fullscreenViewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <FrameLayout
            android:id="@+id/videoControlsOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:focusable="false">
            <LinearLayout
                android:id="@+id/videoControlContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:clickable="false"
                android:focusable="false"
                android:visibility="gone">



                <!-- MIDDLE: play / pause / skip -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:padding="24dp">

                        <ImageButton
                            android:id="@+id/btnSkipBackward"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:src="@drawable/ic_skip_back"
                            android:background="#00000000"
                            app:tint="#FFFFFF"
                            android:scaleType="centerInside" />

                        <ImageButton
                            android:id="@+id/btnCenterPlayPause"
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:src="@android:drawable/ic_media_play"
                            android:background="#00000000"
                            app:tint="#FFFFFF"
                            android:layout_marginStart="24dp"
                            android:layout_marginEnd="24dp"
                            android:scaleType="centerInside" />

                        <ImageButton
                            android:id="@+id/btnSkipForward"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:src="@drawable/ic_skip_forward"
                            android:background="#00000000"
                            app:tint="#FFFFFF"
                            android:scaleType="centerInside" />
                    </LinearLayout>
                </FrameLayout>

                <!-- BOTTOM: seek bar — pushed well up (30% taller than the
                     bottom action bar) so it sits comfortably above it -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="120dp">
                    <!-- 120dp bottom padding: 30% more than the previous 80dp,
                         and it clears the elevated fullscreenBottomBar above it. -->

                    <TextView
                        android:id="@+id/videoTimeCurrent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:shadowColor="#80000000"
                        android:shadowDx="1"
                        android:shadowDy="1"
                        android:shadowRadius="2"
                        android:textSize="13sp" />

                    <SeekBar
                        android:id="@+id/videoSeekBar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:progress="0"
                        android:max="1000" />

                    <TextView
                        android:id="@+id/videoTimeTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:shadowColor="#80000000"
                        android:shadowDx="1"
                        android:shadowDy="1"
                        android:shadowRadius="2"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/fullscreenInfoHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:orientation="vertical"
            android:background="#00000000"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:elevation="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/fullscreenInfoName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="image.jpg"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:shadowColor="#80000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:singleLine="true"
                android:ellipsize="middle" />

            <TextView
                android:id="@+id/fullscreenInfoDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="1920x1080 · 2.4 MB"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:shadowColor="#80000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/fullscreenInfoPath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="/storage/emulated/0/"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:shadowColor="#80000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:singleLine="true"
                android:ellipsize="middle" />


        </LinearLayout>

        <!-- ===== FULLSCREEN BOTTOM ACTION BAR (shown with chrome) ===== -->
        <LinearLayout
            android:id="@+id/fullscreenBottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#00000000"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="20dp"
            android:elevation="24dp"
            android:visibility="gone">

            <!-- Bin -->
            <LinearLayout
                android:id="@+id/fsBtnBin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_delete"
                    app:tint="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Bin"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:shadowColor="#80000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="2" />
            </LinearLayout>

            <!-- Share -->
            <LinearLayout
                android:id="@+id/fsBtnShare"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@android:drawable/ic_menu_share"
                    app:tint="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Share"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:shadowColor="#80000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="2" />
            </LinearLayout>

            <!-- Info -->
            <LinearLayout
                android:id="@+id/fsBtnInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_info"
                    app:tint="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Info"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:shadowColor="#80000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="2" />
            </LinearLayout>

            <!-- Favorite -->
            <LinearLayout
                android:id="@+id/fsBtnFavorite"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/fsBtnFavoriteIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_star_empty"
                    app:tint="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Favorite"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:shadowColor="#80000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="2" />
            </LinearLayout>

        </LinearLayout>
        <!-- ═══ Volume percentage — RIGHT side (no background, no label) ═══ -->
        <TextView
            android:id="@+id/mediaHudVolume"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="40dp"
            android:text="50%"
            android:textColor="#FFFFFF"
            android:textSize="42sp"
            android:textStyle="bold"
            android:shadowColor="#80000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="6"
            android:elevation="40dp"
            android:visibility="gone" />

        <!-- ═══ Brightness percentage — LEFT side (no background, no label) ═══ -->
        <TextView
            android:id="@+id/mediaHudBrightness"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="40dp"
            android:text="50%"
            android:textColor="#FFFFFF"
            android:textSize="42sp"
            android:textStyle="bold"
            android:shadowColor="#80000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="6"
            android:elevation="40dp"
            android:visibility="gone" />


    </RelativeLayout>
    <!-- ===== BOTTOM BAR ===== -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FF000000"
        android:elevation="16dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <TextView android:id="@+id/btnHome" style="@style/BottomBarButton"
            android:layout_marginEnd="6dp" android:text="🏠 Home" />
        <TextView android:id="@+id/btnAlbums" style="@style/BottomBarButton"
            android:layout_marginStart="6dp" android:layout_marginEnd="6dp" android:text="📁 Albums" />
        <TextView android:id="@+id/btnSort" style="@style/BottomBarButton"
            android:layout_marginStart="6dp" android:text="🔽 Sort" />
    </LinearLayout>

    <!-- ===== SELECTION BOTTOM BAR ===== -->
    <LinearLayout
        android:id="@+id/selectionBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FF000000"
        android:elevation="16dp"
        android:padding="8dp"
        android:visibility="gone">

        <TextView android:id="@+id/btnBinSelected" style="@style/BottomBarButton"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center"
            android:text="🗑️ Bin" android:textColor="#FF4444" android:textSize="14sp" />
        <View android:layout_width="1dp" android:layout_height="match_parent"
            android:background="#33FFFFFF" />
        <TextView android:id="@+id/btnShareSelected" style="@style/BottomBarButton"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center"
            android:text="📤 Share" android:textColor="#FFFFFF" android:textSize="14sp" />
        <View android:layout_width="1dp" android:layout_height="match_parent"
            android:background="#33FFFFFF" />
        <TextView android:id="@+id/btnInfoSelected" style="@style/BottomBarButton"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center"
            android:text="ℹ️ Info" android:textColor="#FFFFFF" android:textSize="14sp" />
        <View android:layout_width="1dp" android:layout_height="match_parent"
            android:background="#33FFFFFF" />
        <TextView android:id="@+id/btnFavoriteSelected" style="@style/BottomBarButton"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center"
            android:text="⭐ Favorite" android:textColor="#FFFFFF" android:textSize="14sp" />
    </LinearLayout>

    <!-- ===== BIN BOTTOM BAR ===== -->
    <LinearLayout
        android:id="@+id/binBottomBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FF000000"
        android:elevation="16dp"
        android:padding="8dp"
        android:visibility="gone">

        <TextView android:id="@+id/btnRestore" style="@style/BottomBarButton"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center"
            android:text="↩️ Restore" android:textColor="#4CAF50" android:textSize="14sp" />
        <View android:layout_width="1dp" android:layout_height="match_parent"
            android:background="#33FFFFFF" />
        <TextView android:id="@+id/btnDeletePermanent" style="@style/BottomBarButton"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center"
            android:text="🗑️ Delete" android:textColor="#FF4444" android:textSize="14sp" />
    </LinearLayout>

    <!-- ===== SORT OPTIONS ===== -->
    <LinearLayout
        android:id="@+id/sortOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/bottomBar"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="#FF000000"
        android:padding="8dp"
        android:elevation="12dp">
        <TextView android:id="@+id/sortImages" style="@style/SortOptionButton"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:gravity="center" android:text="🖼️ Images"
            android:background="#FF000000"
            android:textColor="#FFFFFF" android:textSize="16sp" android:padding="8dp" />
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#FF000000" />
        <TextView android:id="@+id/sortVideos" style="@style/SortOptionButton"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:gravity="center" android:text="🎬 Videos"
            android:background="#FF000000"
            android:textColor="#FFFFFF" android:textSize="16sp" android:padding="8dp" />
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#FF000000" />
        <TextView android:id="@+id/sortFavorites" style="@style/SortOptionButton"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:gravity="center" android:text="⭐ Favorites"
            android:background="#FF000000"
            android:textColor="#FFFFFF" android:textSize="16sp" android:padding="8dp" />
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#FF000000" />
        <TextView android:id="@+id/sortBin" style="@style/SortOptionButton"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:gravity="center" android:text="🗑️ Bin"
            android:background="#FF000000"
            android:textColor="#FFFFFF" android:textSize="16sp" android:padding="8dp" />
    </LinearLayout>

    <!-- ===== LEGACY VIDEO PLAYER (hidden, unused) ===== -->
    <RelativeLayout
        android:id="@+id/videoPlayerContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#CC000000"
        android:clickable="true"
        android:focusable="true">

        <VideoView
            android:id="@+id/videoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true" />

        <LinearLayout
            android:id="@+id/videoCenterControls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone">

        </LinearLayout>

        <LinearLayout
            android:id="@+id/videoBottomControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="12dp"
            android:background="#FF000000"
            android:visibility="gone">

            <ImageButton android:id="@+id/btnFavorite" style="@style/LegacyVideoButton"
                android:layout_width="0dp" android:layout_height="40dp"
                android:layout_weight="1" android:src="@drawable/ic_star_empty"
                app:tint="#FFD700" />
            <ImageButton android:id="@+id/btnDelete" style="@style/LegacyVideoButton"
                android:layout_width="0dp" android:layout_height="40dp"
                android:layout_weight="1" android:src="@drawable/ic_delete"
                app:tint="#FF4444" />
            <ImageButton android:id="@+id/btnPlayPause" style="@style/LegacyVideoButton"
                android:layout_width="0dp" android:layout_height="48dp"
                android:layout_weight="1.5" android:src="@android:drawable/ic_media_play" />
            <ImageButton android:id="@+id/btnRotate" style="@style/LegacyVideoButton"
                android:layout_width="0dp" android:layout_height="40dp"
                android:layout_weight="1" android:src="@drawable/ic_rotate" />
            <ImageButton android:id="@+id/btnInfo" style="@style/LegacyVideoButton"
                android:layout_width="0dp" android:layout_height="40dp"
                android:layout_weight="1" android:src="@drawable/ic_info" />
            <ImageButton android:id="@+id/btnCloseVideo" style="@style/LegacyVideoButton"
                android:layout_width="0dp" android:layout_height="40dp"
                android:layout_weight="1" android:src="@drawable/ic_close" />
        </LinearLayout>

        <TextView
            android:id="@+id/videoTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/videoBottomControls"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="8dp"
            android:text="00:00 / 00:00"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:visibility="gone" />
    </RelativeLayout>

</RelativeLayout>