<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_alarm_root"
    android:orientation="horizontal"
    android:padding="16dp"
    android:layout_marginBottom="10dp"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card_alarm"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/item_alarm_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="07:00 AM"
            android:textColor="#00FF00"
            android:textSize="26sp"
            android:typeface="monospace"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/item_alarm_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Once"
            android:textColor="#00AA00"
            android:textSize="12sp"
            android:typeface="monospace"/>
    </LinearLayout>

    <CheckBox
        android:id="@+id/item_alarm_enable"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="#00FF00"/>
</LinearLayout>