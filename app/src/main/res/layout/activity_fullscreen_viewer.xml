<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- ViewPager for swiping -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/fullscreenViewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Video Controls Overlay -->
    <RelativeLayout
        android:id="@+id/videoControlsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true">

        <!-- Control Container -->
        <RelativeLayout
            android:id="@+id/videoControlContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#00000000"
            android:visibility="visible">

            <!-- Center Controls -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="#00000000"
                android:padding="24dp"
                android:elevation="24dp">

                <ImageButton
                    android:id="@+id/btnSkipBackward"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_skip_back"
                    android:background="#00000000"
                    app:tint="#FFFFFF"
                    android:scaleType="centerInside" />

                <ImageButton
                    android:id="@+id/btnCenterPlayPause"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:src="@android:drawable/ic_media_play"
                    android:background="#00000000"
                    app:tint="#FFFFFF"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"
                    android:scaleType="centerInside" />

                <ImageButton
                    android:id="@+id/btnSkipForward"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_skip_forward"
                    android:background="#00000000"
                    app:tint="#FFFFFF"
                    android:scaleType="centerInside" />
            </LinearLayout>

            <!-- Bottom Controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="#33000000">

                <!-- Seek Bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:id="@+id/videoTimeCurrent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />

                    <SeekBar
                        android:id="@+id/videoSeekBar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:progress="0"
                        android:max="100"
                        android:progressTint="#FFFFFF"
                        android:thumb="@android:color/white" />

                    <TextView
                        android:id="@+id/videoTimeTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Bottom Action Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/videoTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Video Title"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:singleLine="true"
                        android:ellipsize="end" />

                    <!-- NEW: Scale/Fit Button -->
                    <ImageButton
                        android:id="@+id/btnScale"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_fit_screen"
                        android:background="#00000000"
                        app:tint="#FFFFFF"
                        android:layout_marginStart="8dp"
                        android:scaleType="centerInside" />

                    <ImageButton
                        android:id="@+id/btnRotate"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_rotate"
                        android:background="#00000000"
                        app:tint="#FFFFFF"
                        android:layout_marginStart="8dp"
                        android:scaleType="centerInside" />

                    <ImageButton
                        android:id="@+id/btnInfo"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_info"
                        android:background="#00000000"
                        app:tint="#FFFFFF"
                        android:layout_marginStart="8dp"
                        android:scaleType="centerInside" />

                    <ImageButton
                        android:id="@+id/btnFavorite"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_star_empty"
                        android:background="#00000000"
                        app:tint="#FFFFFF"
                        android:layout_marginStart="8dp"
                        android:scaleType="centerInside" />

                    <ImageButton
                        android:id="@+id/btnDelete"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_delete"
                        android:background="#00000000"
                        app:tint="#FF4444"
                        android:layout_marginStart="8dp"
                        android:scaleType="centerInside" />
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>

</RelativeLayout>